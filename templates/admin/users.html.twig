{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - ULC'OCCAZ{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">
        <i class="bi bi-people-fill me-2"></i>
        Gestion des utilisateurs
    </h1>

    {% if is_granted('ROLE_MODERATOR') and not is_granted('ROLE_RESPONSABLE') %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Modérateur :</strong> Vous pouvez voir la liste des utilisateurs et les bannir/débannir. Seuls les responsables peuvent modifier les rôles.
        </div>
    {% endif %}

    <div data-current-user-roles='{{ app.user.roles|json_encode|raw }}' {{ react_component('UserManager') }}></div>
</div>
{% endblock %}

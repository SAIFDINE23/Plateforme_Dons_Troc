{% extends "base.html.twig" %}

{% block title %}ULC'OCCAZ - Plateforme de dons et troc{% endblock %}

{% block body %}
<div class="landing-simple">
    <section class="landing-hero rounded-4 p-4 p-lg-5 mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <p class="text-uppercase small fw-semibold mb-2 landing-kicker">Université du Littoral</p>
                <h1 class="display-5 fw-bold mb-3">Donnez, échangez, réutilisez entre étudiants</h1>
                <p class="lead mb-4">
                    Une plateforme claire et locale pour publier des annonces, échanger via la messagerie
                    et réduire le gaspillage sur les campus ULCO.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('app_login') }}" class="btn btn-light btn-lg">
                        Se connecter
                    </a>
                    <a href="#fonctionnalites" class="btn btn-outline-light btn-lg">
                        Voir les fonctionnalités
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="landing-panel p-4">
                    <h2 class="h5 mb-3">Pourquoi ULC'OCCAZ ?</h2>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="bi bi-check-circle-fill me-2"></i>Publication rapide d'annonces</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill me-2"></i>Messagerie intégrée</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill me-2"></i>Modération par campus</li>
                        <li><i class="bi bi-check-circle-fill me-2"></i>Service 100% gratuit</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section id="fonctionnalites" class="mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="landing-card h-100 p-4">
                    <h3 class="h6 fw-bold mb-2">1. Publier</h3>
                    <p class="mb-0 text-muted">Ajoutez des photos, une description et le campus en quelques clics.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="landing-card h-100 p-4">
                    <h3 class="h6 fw-bold mb-2">2. Discuter</h3>
                    <p class="mb-0 text-muted">Contactez le donneur ou l'échangeur directement depuis la messagerie.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="landing-card h-100 p-4">
                    <h3 class="h6 fw-bold mb-2">3. Finaliser</h3>
                    <p class="mb-0 text-muted">Organisez l'échange facilement avec un suivi clair de l'état des annonces.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="landing-campus rounded-4 p-4 p-lg-5">
        <h2 class="h4 fw-bold mb-3">Campus couverts</h2>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge rounded-pill text-bg-light">Calais</span>
            <span class="badge rounded-pill text-bg-light">Dunkerque</span>
            <span class="badge rounded-pill text-bg-light">Boulogne</span>
            <span class="badge rounded-pill text-bg-light">Saint-Omer</span>
        </div>
    </section>
</div>
{% endblock %}
